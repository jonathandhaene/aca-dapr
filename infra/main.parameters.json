{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "acrName": {
      "value": "<your-acr-name>"
    },
    "serviceBusNamespaceName": {
      "value": "<unique-sb-namespace-name>"
    },
    "serviceBusDefaultMessageTimeToLive": {
      "value": "P14D"
    },
    "dispatcherImage": {
      "value": "<your-acr-name>.azurecr.io/dispatcher:latest"
    },
    "level0Image": {
      "value": "<your-acr-name>.azurecr.io/level0-job:latest"
    },
    "level2Image": {
      "value": "<your-acr-name>.azurecr.io/level2-job:latest"
    }
  }
}
